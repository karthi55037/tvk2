# ---- CSE B Class configuration ----
# Copy to .env and adjust. `npm run setup` can generate this file for you.

# SQLite (default). For production Postgres, swap the provider in prisma/schema.prisma
# and set e.g. postgresql://user:pass@host:5432/cseb
DATABASE_URL="file:./dev.db"

# 64-char random secret used to sign session tokens. Generate: openssl rand -hex 32
JWT_SECRET="change-me-generate-with-setup-script"

# Timezone used for "today"/"tomorrow" and timetable (college local time)
APP_TZ="Asia/Kolkata"

# Folder where uploaded files are stored (never served statically)
STORAGE_DIR="./storage"

# Maximum upload size in MB
MAX_UPLOAD_MB="10"

# Public base URL of the app (used for push subscription scope)
APP_ORIGIN="http://localhost:3000"

# VAPID keys for Web Push (optional — `npm run setup` generates them).
# Without these, in-app + real-time notifications still work; push when app is closed needs them.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@cseb.example.edu"
