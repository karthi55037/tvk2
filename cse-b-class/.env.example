# Copy to .env (or set in your host's dashboard). `npm run setup` generates secrets for you.
DATABASE_URL=file:/data/app.db
JWT_SECRET=change-me-to-a-long-random-string
APP_TZ=Asia/Kolkata
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=10
APP_ORIGIN=https://your-domain.example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional: seed the demo class on first boot (Docker image only)
# SEED_DEMO=1
